# Pulse — environment variable template.
# Copy ke `server/.env` dan isi nilai sesuai environment. Jangan commit file .env.

# Runtime environment: "dev" atau "prod".
ENV=dev

# Port HTTP server Go.
PORT=8080

# DSN Postgres.
DATABASE_URL=postgres://pulse:pulse@127.0.0.1:5433/pulse?sslmode=disable

# Redis URL.
REDIS_URL=redis://localhost:6379/0

# JWT secret (HS256). GANTI di produksi — openssl rand -base64 48
JWT_SECRET=change-me-in-production-please-use-a-long-random-string

# TTL access token.
JWT_ACCESS_TTL=15m

# TTL refresh token (httpOnly cookie).
REFRESH_TTL=720h

# Origin frontend untuk CORS.
CORS_ORIGIN=http://localhost:3000

# (Frontend) API & WS URL — set di web/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_WS_URL=ws://localhost:8080
