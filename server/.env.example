# Pulse server — env vars. Copy ke server/.env dan sesuaikan.
ENV=dev
PORT=8080
# For Docker Compose: DATABASE_URL=postgres://pulse:pulse@postgres:5432/pulse?sslmode=disable
# For host dev:       DATABASE_URL=postgres://pulse:pulse@localhost:5433/pulse?sslmode=disable
DATABASE_URL=postgres://pulse:pulse@postgres:5432/pulse?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL=720h
CORS_ORIGIN=http://localhost:3000
